{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "fontStack": {"type":"object","additionalProperties":false,"required":["cjk","latin","css"],"properties":{"cjk":{"type":"string","minLength":1},"latin":{"type":"string","minLength":1},"css":{"type":"string","minLength":1}}},
    "typeScale": {"type":"object","additionalProperties":false,"required":["page_title","section_title","body","caption"],"properties":{"page_title":{"type":"number","minimum":12,"maximum":72},"section_title":{"type":"number","minimum":10,"maximum":48},"body":{"type":"number","minimum":8,"maximum":32},"caption":{"type":"number","minimum":8,"maximum":24}}},
    "typography": {"type":"object","additionalProperties":false,"required":["name_zh","heading","body","body_size","type_scale_pt"],"properties":{"name_zh":{"type":"string"},"heading":{"$ref":"#/$defs/fontStack"},"body":{"$ref":"#/$defs/fontStack"},"body_size":{"type":"number","exclusiveMinimum":0},"type_scale_pt":{"$ref":"#/$defs/typeScale"}}},
    "styleAxes": {"type":"object","additionalProperties":false,"required":["formal","modern","minimal"],"properties":{"formal":{"type":"integer","minimum":0,"maximum":100},"modern":{"type":"integer","minimum":0,"maximum":100},"minimal":{"type":"integer","minimum":0,"maximum":100}}},
    "regionalStyle": {"type":"object","additionalProperties":false,"required":["enabled"],"properties":{"enabled":{"type":"boolean"},"region":{"type":"string","maxLength":120}}},
    "templateSelection": {"type":"object","additionalProperties":false,"required":["id","label","version","substyle_id","override_fields"],"properties":{"id":{"enum":["policy-project-brief","brand-narrative-business","evidence-investment-bp"]},"label":{"type":"string","minLength":1},"version":{"const":"1.0"},"substyle_id":{"type":["string","null"]},"override_fields":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}}}},
    "imageRole": {"type":"object","additionalProperties":false,"required":["role","proportion"],"properties":{"role":{"enum":["text-structure","evidence","technical-evidence","product-evidence","narrative","balanced"]},"proportion":{"enum":["low","medium-low","medium","high"]}}},
    "bounds": {"type":"object","additionalProperties":false,"required":["x","y","w","h"],"properties":{"x":{"type":"number","minimum":0,"maximum":1},"y":{"type":"number","minimum":0,"maximum":1},"w":{"type":"number","exclusiveMinimum":0,"maximum":1},"h":{"type":"number","exclusiveMinimum":0,"maximum":1}}},
    "legacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage","status","confirmed_at","canvas","page_count","pagination_mode","one_page_to_one_slide","direction","template_selection","visual_style","color","icons","typography","image_rendering","style_axes","layout_preferences","information_density","regional_style","background_system","image_role","evidence_strength","composition_tendency","brand_device","production_profile","additional_requirements","formula_policy","generation_mode","refine_spec","image_quality","max_concurrency","automatic_repair_budget","editable_output","start_generation"],
      "properties": {
        "stage":{"const":"final"},"status":{"const":"confirmed"},"confirmed_at":{"type":"string","minLength":1},
        "canvas":{"const":"ppt169"},"page_count":{"type":"integer","minimum":1},"pagination_mode":{"type":"string","minLength":1},"one_page_to_one_slide":{"const":true},
        "direction":{"type":"integer","minimum":0},"template_selection":{"$ref":"#/$defs/templateSelection"},"visual_style":{"type":"string","minLength":1},"color":{"type":"object"},"icons":{"type":"string","minLength":1},"typography":{"$ref":"#/$defs/typography"},"image_rendering":{"type":"object"},"style_axes":{"$ref":"#/$defs/styleAxes"},"layout_preferences":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["auto","editorial","conclusion-first","split","table","matrix","data-led","timeline","modular"]}},"information_density":{"enum":["low","balanced","high"]},"regional_style":{"$ref":"#/$defs/regionalStyle"},"background_system":{"enum":["light","dark","mixed","light-with-dark-highlights"]},"image_role":{"$ref":"#/$defs/imageRole"},"evidence_strength":{"enum":["business","data-case","strict"]},"composition_tendency":{"enum":["auto","formal-consulting","brand-editorial","technical-rd","product-launch"]},"brand_device":{"enum":["none","light","medium","strong"]},"production_profile":{"enum":["quality","balanced","speed"]},"additional_requirements":{"type":"string","maxLength":2000},
        "image_usage_policy":{"enum":["content-driven","visual-preference","source-only"]},"formula_policy":{"enum":["mixed","editable","rendered"]},"generation_mode":{"enum":["continuous","split"]},"refine_spec":{"type":"boolean"},"image_quality":{"enum":["auto","low","medium","high"]},"max_concurrency":{"type":"integer","minimum":1,"maximum":3},"automatic_repair_budget":{"type":"integer","minimum":0,"maximum":3},"editable_output":{"type":"boolean"},"start_generation":{"const":true}
      }
    },
    "confirmedPage": {"type":"object","additionalProperties":false,"required":["page_number","effective_body","attachment_extracts","chart_facts","image_requirements","degradations","reference_images","reference_decisions"],"properties":{"page_number":{"type":"integer","minimum":1},"effective_body":{"type":"string"},"attachment_extracts":{"type":"array"},"chart_facts":{"type":"array"},"image_requirements":{"type":"array"},"degradations":{"type":"array"},"reference_images":{"type":"array","maxItems":16},"reference_decisions":{"type":"array","items":{"oneOf":[{"type":"object","additionalProperties":false,"required":["request_id","decision"],"properties":{"request_id":{"type":"string","minLength":1},"decision":{"enum":["accept","reject"]}}},{"type":"object","additionalProperties":false,"required":["reference_id","decision"],"properties":{"reference_id":{"type":"string","minLength":1},"decision":{"enum":["keep","remove"]}}}]}}}},
    "v6": {"type":"object","additionalProperties":false,"required":["status","revision","confirmed_at","global_visual_contract","production_profile","confirmed_pages"],"properties":{"status":{"const":"confirmed"},"revision":{"type":"integer","minimum":1},"confirmed_at":{"type":"string","minLength":1},"global_visual_contract":{"$ref":"#/$defs/legacy"},"production_profile":{"enum":["quality","balanced","speed"]},"confirmed_pages":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/confirmedPage"}}}}
  },
  "oneOf": [{"$ref":"#/$defs/legacy"}, {"$ref":"#/$defs/v6"}]
}
