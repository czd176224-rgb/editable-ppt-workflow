{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "canvasProfile":{"type":"object","additionalProperties":false,"required":["aspect_ratio","image_size","slide_width_inches","slide_height_inches","fit","allow_crop"],"properties":{"aspect_ratio":{"enum":["16:9","4:3"]},"image_size":{"enum":["1792x1008","1536x1152"]},"slide_width_inches":{"type":"number","exclusiveMinimum":0},"slide_height_inches":{"type":"number","exclusiveMinimum":0},"fit":{"const":"contain"},"allow_crop":{"const":false}}}
  },
  "type":"object","additionalProperties":false,
  "required":["schema_version","canvas","canvas_profile","hard_constraints","soft_preferences","creative_freedom"],
  "properties":{
    "schema_version":{"const":"2.0"},
    "canvas":{"enum":["ppt169","ppt43"]},
    "canvas_profile":{"$ref":"#/$defs/canvasProfile"},
    "hard_constraints":{"type":"object","additionalProperties":false,"required":["content_fidelity","one_page_to_one_slide","title_color","palette","typography"],"properties":{"content_fidelity":{"const":"preserve_information_and_logic"},"one_page_to_one_slide":{"const":true},"title_color":{"type":"string","pattern":"^#[0-9A-Fa-f]{6}$"},"palette":{"type":"object"},"typography":{"type":"object"}}},
    "soft_preferences":{"type":"object","additionalProperties":false,"required":["direction","template_selection","visual_style","color","icons","typography","image_rendering","style_axes","layout_preferences","information_density","regional_style","background_system","image_role","evidence_strength","composition_tendency","brand_device","additional_requirements"],"properties":{"direction":{"type":"integer","minimum":0},"template_selection":{"type":"object"},"visual_style":{"type":"string","minLength":1},"color":{"type":"object"},"icons":{"type":"string","minLength":1},"typography":{"type":"object"},"image_rendering":{"type":"object"},"style_axes":{"type":"object"},"layout_preferences":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},"information_density":{"enum":["low","balanced","high"]},"regional_style":{"type":"object"},"background_system":{"enum":["light","dark","mixed","light-with-dark-highlights"]},"image_role":{"type":"object"},"evidence_strength":{"enum":["business","data-case","strict"]},"composition_tendency":{"enum":["auto","formal-consulting","brand-editorial","technical-rd","product-launch"]},"brand_device":{"enum":["none","light","medium","strong"]},"additional_requirements":{"type":"string","maxLength":2000}}},
    "creative_freedom":{"type":"object","additionalProperties":false,"required":["layout","composition","visual_hierarchy","content_visualization","page_specific_emphasis"],"properties":{"layout":{"const":true},"composition":{"const":true},"visual_hierarchy":{"const":true},"content_visualization":{"const":true},"page_specific_emphasis":{"const":true}}}
  }
}
